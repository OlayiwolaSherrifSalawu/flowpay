# FLOWPAY BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env or backend/.env

# Node Server
PORT=4000
NODE_ENV=development

# FlowPay API Secret / JWT (for FlowPay app session auth)
FLOWPAY_JWT_SECRET=flowpay_development_secret_change_in_production_min32chars

# PostgreSQL Connection URI (Supabase session pooler URI or local postgresql://...)
DATABASE_URL=postgresql://postgres:flowpay@localhost:5435/flowpay

# AI Financial Operator Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Mail Service Configuration (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
MAIL_FROM_NAME=FlowPay
MAIL_FROM_ADDRESS=

# Paystack API Configuration (for Nigerian bank resolution / NUBAN verification)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Stellar Network (see .agents/skills/stellar/SKILL.md)
# Run `cd backend && npm run stellar:bootstrap` to generate the testnet treasury and fill these in.
STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ASSET_ISSUER=
STELLAR_ISSUER_SECRET=
STELLAR_DISTRIBUTOR_SECRET=
# Optional per-asset override "CODE:ISSUER" (e.g. mainnet Circle USDC)
# STELLAR_ASSET_USD=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
