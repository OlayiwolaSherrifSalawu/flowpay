# FLOWPAY BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env or backend/.env

# Node Server
PORT=4000
NODE_ENV=development

# FlowPay API Secret / JWT (for FlowPay app session auth)
FLOWPAY_JWT_SECRET=flowpay_development_secret_change_in_production_min32chars

# SQLite Database File Path (defaults to local file in backend directory)
DATABASE_URL=./flowpay.db

# BMONI Financial Infrastructure
# Sandbox Base URL (Origin-only, DO NOT append /v1)
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# BMONI Partner API Key (Server-side only — NEVER expose to client or Flutter)
BMONI_API_KEY=bmoni_partner_key_here

# BMONI Webhook HMAC Secret (Returned when creating webhook config)
BMONI_WEBHOOK_SECRET=87f88be98b96faf6d6ece5b26bf4a9fe20739ae9634fb7b530a24aac4f71ed32

# BMONI Partner Scope ID
BMONI_PARTNER_ID=b7e6a1d0-4f3c-4c2a-9e8b-1a2b3c4d5e6f

# AI Financial Operator Configuration
OPENAI_API_KEY=optional_openai_key_for_nlp_interpretation
